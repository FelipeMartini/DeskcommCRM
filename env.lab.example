# Configuração do DeskcommCRM para o host 10.1.1.4 (Homologação / Produção)
NEXT_PUBLIC_APP_URL=https://deskcommcrm.poa.metodoatuarial.com.br
DESKCOMM_SSO_SECRET=sua_chave_secreta_super_forte_gerada_aqui
# Só o ProjetoSocial pode embutir o CRM em um quadro; qualquer outra origem segue barrada (DENY).
EMBED_FRAME_ANCESTORS=https://social.poa.metodoatuarial.com.br

# Senha do Postgres (o container expanda-crm-db usa esta senha)
POSTGRES_PASSWORD=sua_senha_segura_do_postgres_aqui

# Chaves WAHA (WhatsApp HTTP API com engine NOWEB)
WAHA_API_KEY=sua_chave_waha_plaintext
WAHA_API_KEY_SHA512=sua_chave_waha_sha512
