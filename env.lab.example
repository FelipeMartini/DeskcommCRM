# Configuração do DeskcommCRM para o host 10.1.1.4 (Homologação / Produção)
NEXT_PUBLIC_APP_URL=https://crm.poa.metodoatuarial.com.br
DESKCOMM_SSO_SECRET=insira_o_segredo_compartilhado_com_o_projetosocial_aqui

# Conexão com o banco Postgres em 10.1.1.4 (Database isolado deskcomm_db)
POSTGRES_PASSWORD=insira_a_senha_do_postgres_aqui
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@10.1.1.4:5432/deskcomm_db
SUPABASE_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@10.1.1.4:5432/deskcomm_db

# Chaves WAHA (WhatsApp HTTP API com engine NOWEB)
WAHA_API_KEY=minha_chave_secreta_plaintext
WAHA_API_KEY_SHA512=hash_sha512_da_chave_waha

# Cache / Rate limit
REDIS_URL=redis://10.1.1.4:6379/2
